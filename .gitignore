# Build output
bin/
obj/
.vs/
*.user
*.suo
release/
publish/

# Generated build output (build.ps1 rebuilds all of it; never commit binaries).
# Everything generated lives under dist/ and nothing else does — the installer SOURCE
# is installer/RiveTT.iss and stays versioned. The old distribution/ folder mixed the
# two, which is why it is gone.
dist/

# Local run logs from deploy/install scripts
/*.log

# Claude Code local state (settings.local.json is tracked intentionally)
.claude/
.claude/scheduled_tasks.lock
.claude/worktrees/
.worktrees/

# Artifacts generated by AI test sessions under docs/ — never source
docs/*.xlsx
docs/*.csv
docs/*.json
docs/gen_*.py
docs/check_*.py

# Ad-hoc screenshots and publish temp dirs
/*.png
/*.jpg
.publish-smoke/

