<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RiveTT.Tools</RootNamespace>
    <AssemblyName>RiveTT.Tools</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Roslyn ships its compiler diagnostics translated into 13 languages: 6.4 MB of
         satellite assemblies, per Revit target, for strings that only ever surface in a
         send_code_to_revit failure or the audit log. Developer-facing, and easier to
         search in English. Keeping "en" alone cuts the plugin payload by roughly a
         quarter with no effect on the tool surface, which is English by contract. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Overridable: dotnet build -p:RevitVersion=2026 targets Revit 2026.5 (also
         .NET 10, per Autodesk's 2026.5 update notes) instead of the 2027 default. -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <!-- REVIT2026_OR_GREATER is unconditional: 2026 is this connector's floor.
         REVIT2027_OR_GREATER only when actually building the 2027 target. -->
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2027'">$(DefineConstants);REVIT2027_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <!-- Roslyn Compiler for the optional send_code_to_revit fallback. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiveTT.Core\RiveTT.Core.csproj" />
  </ItemGroup>
</Project>
