<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RiveTT.Plugin</RootNamespace>
    <AssemblyName>RiveTT.Plugin</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Overridable: dotnet build -p:RevitVersion=2026 targets Revit 2026.5 (also
         .NET 10, per Autodesk's 2026.5 update notes) instead of the 2027 default. -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <!-- Ribbon icons are System.Windows.Media.ImageSource: the Revit UI API is
         WPF, so the plugin needs PresentationCore/WindowsBase. Nothing is copied
         locally - WPF ships with the Windows Desktop runtime Revit already uses. -->
    <UseWPF>true</UseWPF>
    <!-- REVIT2026_OR_GREATER is unconditional: 2026 is this connector's floor.
         REVIT2027_OR_GREATER only when actually building the 2027 target — code
         behind it (e.g. the Coordination Model API) must not compile into a 2026 build. -->
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2027'">$(DefineConstants);REVIT2027_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiveTT.Core\RiveTT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded, not copied: no file to lose next to the DLL, no pack:// URI to
         register inside Revit's add-in load context. Regenerate them with
         tools\make-ribbon-icons.ps1. -->
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

</Project>
