<Project>
  <!--
    Single source of truth for the connector version. It surfaces to callers as
    execution.serverVersion (read from the plugin assembly) and as the MCP
    ServerInfo version in src/RiveTT.Server/Program.cs — keep that literal
    in step when bumping this.
  -->
  <PropertyGroup>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>RiveTT</Product>
    <Company>RiveTT</Company>
    <Copyright>MIT — derived from RevitCortex</Copyright>
  </PropertyGroup>
</Project>
